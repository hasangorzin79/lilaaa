{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lilaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0f289230-1e3e-42e4-849b-5e0e53d0ea10","database_name": "novagf" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8d2d58cdfb95432d8de6c6de86c8574f" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
